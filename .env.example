# Copy to .env (or .env.local) to override the API the frontend talks to.
# Vite reads this at build time; it is baked into the compiled bundle.
#
# Must point at the FastAPI backend and end in /api. If unset, the app
# defaults to the deployed Render backend below, so a plain `npm run build`
# already targets production.
VITE_API_BASE_URL=https://plasticnet-backend.onrender.com/api
